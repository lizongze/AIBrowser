{
  "name": "aibrowser",
  "productName": "AIBrowser",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Chromium 内核的网页预览 + 代码高亮预览工具（AI 可调用）",
  "author": "zongze.li",
  "main": "src/main/main.js",
  "bin": {
    "pvs": "bin/pvs.js",
    "aibrowser-mcp": "bin/aibrowser-mcp.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && concurrently -k \"node scripts/build.mjs --watch\" \"electron .\"",
    "gui": "node bin/pvs.js serve --gui",
    "mcp": "node bin/aibrowser-mcp.js",
    "package": "node scripts/package.mjs",
    "package:all": "node scripts/package.mjs --targets all --arch x64,arm64",
    "package:linux": "node scripts/package.mjs --targets linux --arch x64,arm64",
    "package:win32": "node scripts/package.mjs --targets win32 --arch x64,arm64",
    "package:darwin": "node scripts/package.mjs --targets darwin --arch x64,arm64",
    "panel:check": "electron scripts/panel-check.cjs",
    "postinstall": "node scripts/install-skill.mjs",
    "skill": "node scripts/pack-skill.mjs",
    "skill:all": "node scripts/pack-skill.mjs --platforms all --arch x64,arm64",
    "skill:linux": "node scripts/pack-skill.mjs --platforms linux --arch x64,arm64",
    "skill:win32": "node scripts/pack-skill.mjs --platforms win32 --arch x64,arm64",
    "skill:darwin": "node scripts/pack-skill.mjs --platforms darwin --arch x64,arm64",
    "smoke": "npm run build && electron . --smoke-test --headless",
    "start": "npm run build && electron .",
    "verify": "npm run build && node scripts/verify.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4",
    "@electron/packager": "^20.3.0",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^38.8.6",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  }
}
